    "verify": "node ./scripts/verify.mjs",
    "verify:governance": "node ./scripts/verify.mjs --governance",
    "provider:integration": "node ./scripts/provider-integration.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AVANT-ICONIC/cleanroom.git"
  },
  "bugs": {
