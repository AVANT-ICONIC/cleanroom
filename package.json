{
  "name": "@avant-iconic/cleanroom",
  "version": "1.0.2",
  "description": "A deterministic anti-entropy guardrail for human and agent-generated codebases.",
  "type": "module",
  "bin": {
    "greenroom": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "smoke:consumer": "node ./scripts/smoke-consumer.mjs",
