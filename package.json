  },
  "homepage": "https://github.com/AVANT-ICONIC/cleanroom#readme",
  "keywords": [
    "ai-agents",
    "code-quality",
    "architecture",
    "technical-debt",
    "linting",
    "design-system",
    "ci",
    "agentic-coding"
  ],
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
